<?xml version="1.0" encoding="UTF-8"?>
<!--
  未签名扩展的调试清单。

  CEP 默认要求扩展经过 Adobe 签名才能加载。开发期与开源自装场景下，
  通过开启 PlayerDebugMode 让 Premiere 跳过签名校验，此时本文件生效，
  并开放 8088 端口用于 Chrome DevTools 远程调试：

      Chrome 打开  http://localhost:8088/

  开启方式（Windows）见 install/enable-debug-mode.reg。
  正式发布时请用 ZXPSignCmd 打包签名，并删除本文件。
-->
<ExtensionManifest Version="11.0"
                    ExtensionBundleId="com.arknight.autoediting"
                    ExtensionBundleVersion="1.0.0"
                    ExtensionBundleName="ArknightAutoEditing"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.arknight.autoediting.panel" Version="1.0.0">
      <HostList>
        <Host Name="PPRO" Port="8088" />
      </HostList>
    </Extension>
  </ExtensionList>

</ExtensionManifest>
